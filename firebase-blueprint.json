{
  "entities": {
    "Resume": {
      "title": "Resume",
      "description": "User resume data and extracted text",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId"]
    },
    "Job": {
      "title": "Job",
      "description": "Saved job descriptions and match history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId"]
    },
    "Assessment": {
      "title": "Assessment",
      "description": "Assessment answers and track results",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId"]
    },
    "Report": {
      "title": "Report",
      "description": "Saved match audit reports",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId"]
    },
    "Preferences": {
      "title": "Preferences",
      "description": "User settings and preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}/resumes/{resumeId}": {
      "schema": { "$ref": "#/entities/Resume" },
      "description": "User resumes"
    },
    "/users/{userId}/jobs/{jobId}": {
      "schema": { "$ref": "#/entities/Job" },
      "description": "User jobs and match history"
    },
    "/users/{userId}/assessments/{assessmentId}": {
      "schema": { "$ref": "#/entities/Assessment" },
      "description": "User assessments"
    },
    "/users/{userId}/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "User match reports"
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": { "$ref": "#/entities/Preferences" },
      "description": "User preferences"
    }
  }
}
